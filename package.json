{
  "name": "modelforce",
  "version": "0.1.0",
  "private": true,
  "description": "ModelForce Voice Ecosystem - Universal TTS Runtime, Registry & Character Platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/modelforce/modelforce"
  },
  "license": "MPL-2.0",
"engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:server": "pnpm --filter @modelforce/server dev",
    "dev:web": "pnpm --filter @modelforce/web dev",
    "lint": "eslint packages/*/src/**/*.ts",
    "lint:fix": "eslint packages/*/src/**/*.ts --fix",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"packages/*/src/**/*.ts\""
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0"
  }
}

